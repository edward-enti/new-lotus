# SonLotus — example environment. Copy to .env and fill in real values.
# .env is git-ignored. Placeholders only: NO real or default admin credential.
PORT=:8080
DB_PATH=data/sonlotus.db
DATA_DIR=data
APP_ENV=development
# Public base URL for absolute sitemap/canonical/JSON-LD/robots URLs.
# Example value is the real site domain from SPEC §1. Leave empty for
# local dev, in which case those URLs stay relative (fallback).
SITE_URL=https://sonlotus.com
# Admin login (Phase 3). The server FAILS CLOSED when these are missing/empty.
ADMIN_USER=
ADMIN_PASSWORD=
